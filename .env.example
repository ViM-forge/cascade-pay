# Local demo only. Generate all secrets before running; placeholders are rejected.
POSTGRES_PASSWORD=replace-with-generated-admin-secret
PAYMENTS_DB_PASSWORD=replace-with-generated-payments-secret
MOCK_A_DB_PASSWORD=replace-with-generated-mock-a-secret
MOCK_B_DB_PASSWORD=replace-with-generated-mock-b-secret
JWT_SECRET=replace-with-generated-signing-secret
MOCK_SERVICE_CREDENTIAL=replace-with-generated-service-secret
MERCHANT_IDS=["11111111-1111-4111-8111-111111111111","22222222-2222-4222-8222-222222222222"]
JWT_ISSUER=payments-demo
JWT_AUDIENCE=payments-api
JWT_TTL_SECONDS=900
# Host URLs for local Poetry commands; Compose replaces these with service addresses.
DATABASE_URL=postgresql+asyncpg://payments:replace-with-generated-payments-secret@localhost:5432/payments
REDIS_URL=redis://localhost:6379/0
PROVIDER_A_URL=http://localhost:8001
PROVIDER_B_URL=http://localhost:8002
HTTP_TIMEOUT_SECONDS=2
LEASE_SECONDS=10
RECOVERY_INTERVAL_SECONDS=2
RECONCILIATION_DEADLINE_SECONDS=60
RECONCILIATION_MAX_CHECKS=5
SAFE_RETRY_SECONDS=86400
